# Copy these into Vercel → Project → Settings → Environment Variables
# (and into a local .env.local file if you run it on your computer)

# FREE Gemini API key — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini model the agents try first (others are tried automatically if this one is out of quota)
AGENT_MODEL=gemini-flash-latest

# Notion internal integration secret — https://www.notion.so/profile/integrations
NOTION_TOKEN=

# IDs from your Notion workspace — already filled in for your "Lumen Research Lab HQ" page
NOTION_STATE_PAGE_ID=41adfe99f77e81f5b47ffdded401c23b
NOTION_LOG_DB_ID=41adfe99f77e81a2bbb3fc147f0e77e8
NOTION_OUTPUTS_DB_ID=41adfe99f77e81549570ff16e4defa00
NOTION_OPPORTUNITIES_DB_ID=41adfe99f77e81a69dd7d95afc346748

# Password you type into the dashboard to run the company (make one up)
ADMIN_KEY=

# Random secret Vercel uses to call the daily cron (make one up, long and random)
CRON_SECRET=

# Optional: link to your Notion HQ page, shown on the dashboard
NEXT_PUBLIC_NOTION_URL=https://www.notion.so/41adfe99f77e81388dd8e2c05d5266d6
