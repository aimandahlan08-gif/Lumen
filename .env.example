# Only these 4 are required. Add them in Vercel → Project → Settings → Environment Variables.

# FREE Gemini API key — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Notion connection token — https://www.notion.so/profile/integrations
NOTION_TOKEN=

# Password you type into the dashboard to run the company (make one up)
ADMIN_KEY=

# Random secret Vercel uses to call the daily cron (make one up, long and random)
CRON_SECRET=

# ── Optional (already built into the code) ──
# AGENT_MODEL=gemini-flash-latest
# NOTION_STATE_PAGE_ID / NOTION_LOG_DB_ID / NOTION_OUTPUTS_DB_ID / NOTION_OPPORTUNITIES_DB_ID
# NEXT_PUBLIC_NOTION_URL
